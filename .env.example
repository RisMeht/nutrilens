# Put this value in Vercel as an encrypted Environment Variable. Never prefix it with NEXT_PUBLIC_.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# A small vision model with strong value for food-photo analysis.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Your production URL, used as OpenRouter's optional attribution/referrer header.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
